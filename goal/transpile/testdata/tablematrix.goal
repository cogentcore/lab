##
a := [[1., 2.], [3., 4.]]
b := [[5., 6.], [7., 8.]]
fmt.Println(a @ b)
fmt.Println(a.T)
fmt.Println(matrix.Det(a))
c := [[1., 2., 3.], [4., 5., 6.]]
t := c.T
fmt.Println(t)
fmt.Println(float64(t[2, 0]), float64(t[0, 1]))
fmt.Println(c @ t)
