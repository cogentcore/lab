// the Goal entries of the "Constructing" table of the math mode docs.

##
fmt.Println([1., 2., 3.])
fmt.Println([[1., 2., 3.], [4., 5., 6.]])
fmt.Println(zeros(3, 4).shape)
fmt.Println(zeros(3, 4, 5).shape)
fmt.Println(ones(3, 4))
fmt.Println(full(5.5, 3, 4))
r := rand(3, 4)
fmt.Println(r.shape, float64(r.min()) >= 0, float64(r.max()) < 1)
##
