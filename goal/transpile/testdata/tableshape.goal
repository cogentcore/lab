// the Goal entries of the "Tensor shape" table of the math mode docs.

##
a := [[1., 2., 3.], [4., 5., 6.]]
fmt.Println(ndim(a), a.ndim)
fmt.Println(len(a), a.len, size(a), a.size)
fmt.Println(shape(a), a.shape)
fmt.Println(a.shape[1])
fmt.Println(a.reshape(3, 2))
fmt.Println(reshape(a, 3, 2))
sh := [3, 2]
fmt.Println(a.reshape(sh))
fmt.Println(reshape(a, sh))
fmt.Println(a.reshape(-1))
fmt.Println(reshape(a, -1))
fmt.Println(a.flatten())
b := copy(a)
c := a.copy()
b[0, 0] = 10
c[0, 0] = 20
fmt.Println(float64(a[0, 0]), float64(b[0, 0]), float64(c[0, 0]))
s := zeros(1, 3, 1)
fmt.Println(s.squeeze().shape)
##
