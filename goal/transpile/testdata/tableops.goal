// the Goal entries of the "Basic math operations" table of the math mode
// docs.

##
a := [1., 2., 3.]
b := [4., 5., 6.]
fmt.Println(a + b)
fmt.Println(a * b)
fmt.Println(a / b)
fmt.Println([1, 2] / 4) // always a float result
fmt.Println([7, 8, 9] % 4)
fmt.Println([7.5, 8.5] % 4)
fmt.Println(a ** 3)
fmt.Println(cos([0.]))
fmt.Println(["a", "b"] + "c")
##
