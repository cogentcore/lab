fn Mat4RotateAxis(axis: vec3<f32>, angle: f32) -> mat4x4f {
	var c = cos(angle);
	var s = sin(angle);
	var t = 1 - c;
	var x = axis.x;
	var y = axis.y;
	var z = axis.z;
	var tx = t * x;
	var ty = t * y;
return Mat4Set(
	tx*x+c, tx*y-s*z, tx*z+s*y, f32(f32(0)),
	tx*y+s*z, ty*y+c, ty*z-s*x, f32(f32(0)),
	tx*z-s*y, ty*z+s*x, t*z*z+c, f32(f32(0)),
	f32(f32(0)), f32(f32(0)), f32(f32(0)), f32(f32(1)));
}
