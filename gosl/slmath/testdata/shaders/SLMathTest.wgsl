	t11*di,
	(n31*n23-n33*n21)*di,
	(n32*n21-n31*n22)*di,
	t12*di,
	(n33*n11-n31*n13)*di,
	(n31*n12-n32*n11)*di,
	t13*di,
	(n21*n13-n23*n11)*di,
	(n22*n11-n21*n12)*di);
}
