fn Mat4FromQuat(q: vec4<f32>) -> mat4x4f {
	var x2 = q.x + q.x;
	var y2 = q.y + q.y;
	var z2 = q.z + q.z;
	var xx = q.x * x2;
	var xy = q.x * y2;
	var xz = q.x * z2;
	var yy = q.y * y2;
	var yz = q.y * z2;
	var zz = q.z * z2;
	var wx = q.w * x2;
	var wy = q.w * y2;
	var wz = q.w * z2;
return Mat4Set(
	1-(yy+zz), xy-wz, xz+wy, f32(f32(0)),
	xy+wz, 1-(xx+zz), yz-wx, f32(f32(0)),
	xz-wy, yz+wx, 1-(xx+yy), f32(f32(0)),
	f32(f32(0)), f32(f32(0)), f32(f32(0)), f32(f32(1)));
}
fn Mat4FromEuler(euler: vec3<f32>) -> mat4x4f {
	var a = cos(euler.x);
	var b = sin(euler.x);
	var c = cos(euler.y);
	var d = sin(euler.y);
	var e = cos(euler.z);
	var f = sin(euler.z);
	var ae = a * e;
	var af = a * f;
	var be = b * e;
	var bf = b * f;
return Mat4Set(
	c*e, -c*f, d, f32(f32(0)),
	af+be*d, ae-bf*d, -b*c, f32(f32(0)),
	bf-ae*d, be+af*d, a*c, f32(f32(0)),
	f32(f32(0)), f32(f32(0)), f32(f32(0)), f32(f32(1)));
}
fn Mat4ToEuler(m: mat4x4f) -> vec3<f32> {
	var m11 = m[0][0];
	var m12 = m[1][0];
	var m13 = m[2][0];
	var m22 = m[1][1];
	var m23 = m[2][1];
	var m32 = m[1][2];
	var m33 = m[2][2];
	var v: vec3<f32>;
	v.y = asin(clamp(m13, f32(-1), f32(1)));
	if (abs(m13) < 0.99999) {
		v.x = atan2(-m23, m33);
		v.z = atan2(-m12, m11);
	} else {
		v.x = atan2(m32, m22);
		v.z = f32(0);
	}return v;
}
fn Mat4Transform(pos: vec3<f32>, quat: vec4<f32>, scale: vec3<f32>) -> mat4x4f {
	return Mat4SetPos(Mat4ScaleCols(Mat4FromQuat(quat), scale), pos);
}
fn Mat4ExtractRotation(s: mat4x4f) -> mat4x4f {
	var sx = 1 / Length3(vec3<f32>(s[0][0], s[0][1], s[0][2]));
	var sy = 1 / Length3(vec3<f32>(s[1][0], s[1][1], s[1][2]));
	var sz = 1 / Length3(vec3<f32>(s[2][0], s[2][1], s[2][2]));
return Mat4Set(
	s[0][0]*sx, s[1][0]*sy, s[2][0]*sz, f32(f32(0)),
	s[0][1]*sx, s[1][1]*sy, s[2][1]*sz, f32(f32(0)),
	s[0][2]*sx, s[1][2]*sy, s[2][2]*sz, f32(f32(0)),
	f32(f32(0)), f32(f32(0)), f32(f32(0)), f32(f32(1)));
